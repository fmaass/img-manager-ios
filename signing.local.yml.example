# Per-machine developer signing for RUNNING ON A DEVICE (P0b). Copy to signing.local.yml
# (gitignored), fill in your team id, then run bin/generate.sh.
#   1. Xcode -> Settings -> Accounts -> add your Apple ID (a free personal team is created).
#   2. Your team id shows under the account (or: defaults read com.apple.dt.Xcode IDEProvisioningTeams).
# Never commit a team id, provisioning profile or token — anywhere, ever.
targets:
  ImgManager:
    settings:
      base:
        DEVELOPMENT_TEAM: YOUR_TEAM_ID
        CODE_SIGN_STYLE: Automatic
        CODE_SIGN_IDENTITY: Apple Development
