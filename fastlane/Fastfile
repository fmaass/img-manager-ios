# Headless TestFlight pipeline. Ported from the estate's reference project
# (memos-ng-ios/fastlane/Fastfile) per the WP8 P0b premise-gate fold — adapted for
# img-manager-ios's single app target (no share extension, no EXT_ID, no app-group
# entitlement handling) and hardened with the fold's five closed blockers: enforced
# pin verification INSIDE this lane (not runbook prose), a built-archive pre-upload
# check, a required release-provenance SHA, an explicit no-silent-mint cert decision,
# and a merkur-wide release mutex.
#
# Auth is an App Store Connect API key (no Apple ID / 2FA), and signing runs in a
# dedicated keychain so codesign never touches the GUI login keychain (unreachable
# over SSH -> errSecInternalComponent; that is the whole reason this pipeline exists
# rather than `xcodebuild archive` over ssh — same rationale as the reference).

require "digest"
require "fileutils"
require "json"
require "shellwords"
require "spaceship"
require File.expand_path("lib/asc_readback", __dir__)
require File.expand_path("lib/dsym_store", __dir__)
require File.expand_path("lib/timed_probe", __dir__)
require File.expand_path("lib/archive_check", __dir__)

default_platform(:ios)

APP_ID   = "live.discomarder.imgmanager"
TEAM_ID  = "Y2JQ4VAF85"
SCHEME   = "ImgManager"
PROJECT  = "ImgManager.xcodeproj"
KEYCHAIN = "imgmanager-ci.keychain-db"
KEYPATH  = File.expand_path("~/Library/Keychains/#{KEYCHAIN}")
ROOT     = File.expand_path("..", __dir__)
ARCHIVE  = "#{ROOT}/build/ImgManager.xcarchive"
IPA      = "#{ROOT}/build/ImgManager.ipa"
GROUP    = "household"

# Off-host first: merkur's build dirs are reaped for disk and its disk is the single point of
# failure, so the primary store is the NAS. lexosaurus is the local fallback and says so loudly.
# Same estate infra as memos-ng-ios; only the subpath below is per-project.
DSYM_STORES     = [["janus", "/Users/Shared/nas/janus"], ["lexosaurus", "/Volumes/lexosaurus"]].freeze
DSYM_SUBPATH    = "img-manager-ios/dSYMs"
ATTACH_TIMEOUT  = 300
ATTACH_INTERVAL = 20
# A store probe answers in milliseconds when the mount is healthy; anything past this is a hang.
DSYM_PROBE_TIMEOUT = 10

# Fold item 7 / diff-gate blocker 2: a merkur-wide mutex against the memos-ng-ios pipeline.
# memos-ng-ios's own Fastfile (branch fix/shared-release-lock, MEMNG-195) now flocks this SAME
# path with the SAME default (~/.release-lock) around the same critical section (keychain-
# search-list mutation, cert/profile prep, the archive) -- once both branches are merged this is
# a real cross-pipeline mutex, not merely self-protection. `flock` is cooperative: it only works
# because both Fastfiles agree to take it, which is why the default path (not just the override
# name) has to match exactly between the two repos.
RELEASE_LOCK_PATH = File.expand_path("~/.release-lock") # non-overridable: an override would defeat the cross-pipeline mutex

def api_key
  app_store_connect_api_key(
    key_id:       ENV.fetch("ASC_KEY_ID"),
    issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house:     false,
  )
end

# Serializes keychain-search-list mutation, cert/profile prep and the archive itself (fold item
# 7) -- a bash 3.2 build host has no flock(1) (same constraint the reference gate's own comment
# names for mac-gate.sh), so this uses Ruby's File#flock directly rather than shelling out.
def with_release_lock
  UI.message("release lock: waiting on #{RELEASE_LOCK_PATH} (blocks until no other release -- " \
             "this or memos-ng-ios's -- holds it)")
  File.open(RELEASE_LOCK_PATH, File::CREAT | File::RDWR, 0o644) do |lock|
    acquired_at = Time.now
    lock.flock(File::LOCK_EX)
    lock.write("pid=#{Process.pid} project=img-manager-ios lane=archive_ipa at=#{Time.now.utc}\n")
    lock.flush
    UI.message("release lock: acquired after #{(Time.now - acquired_at).round(1)}s")
    begin
      yield
    ensure
      lock.flock(File::LOCK_UN)
      UI.message("release lock: released")
    end
  end
end

# Fold item 7: cert against a freshly created, empty keychain must never be allowed to silently
# mint a new Apple Distribution certificate -- that consumes a certificate slot and is not
# reversible from this side. The choice (import the existing exportable .p12 vs create a second
# cert after a quota check) is a live Apple-portal decision this file cannot make; it is made at
# merkur first-action (fold item 9) and recorded there. This lane refuses to guess: it requires
# IMGMGR_CERT_STRATEGY to be set explicitly to the decided value.
#
# The keychain itself is meant to be REUSED across every release after the proof, not recreated
# each time (diff-gate blocker 5: refusing outright on existence made every release after the
# first impossible). What must never happen is silently adopting a keychain this pipeline did
# not create -- so reuse is gated on a marker file written the moment this pipeline creates the
# keychain, and existence WITHOUT that marker is still refused exactly as before.
KEYCHAIN_MARKER = "#{KEYPATH}.imgmanager-ci-marker".freeze
KEYCHAIN_MARKER_CONTENT = "imgmanager-ci keychain -- created by fastlane/Fastfile#prepare_signing\n".freeze

def prepare_signing(key)
  kc_pw = ENV.fetch("CI_KEYCHAIN_PW")

  if File.exist?(KEYPATH)
    recognized = File.exist?(KEYCHAIN_MARKER) && File.read(KEYCHAIN_MARKER) == KEYCHAIN_MARKER_CONTENT
    UI.user_error!(
      "prepare_signing: #{KEYCHAIN} exists at #{KEYPATH} but carries no recognized " \
      "#{File.basename(KEYCHAIN_MARKER)} -- refusing to reuse or overwrite a keychain this " \
      "pipeline did not create. Remove both the keychain and the marker deliberately first " \
      "if this run is meant to replace it."
    ) unless recognized
    UI.message("prepare_signing: reusing the existing #{KEYCHAIN} this pipeline created " \
               "(recognition marker verified)")
    unlock_keychain(path: KEYPATH, password: kc_pw)
  else
    create_keychain(
      name: KEYCHAIN, password: kc_pw, default_keychain: false,
      unlock: true, timeout: 7200, lock_when_sleeps: false, add_to_search_list: true,
    )
    unlock_keychain(path: KEYPATH, password: kc_pw)
    File.write(KEYCHAIN_MARKER, KEYCHAIN_MARKER_CONTENT)
    UI.message("prepare_signing: created #{KEYCHAIN} and wrote its recognition marker")
  end

  strategy = ENV.fetch("IMGMGR_CERT_STRATEGY", "").strip
  unless %w[import create].include?(strategy)
    UI.user_error!(
      "prepare_signing: IMGMGR_CERT_STRATEGY must be \"import\" or \"create\" -- there is no " \
      "default. Decide at the merkur first-action portal census (fold item 9: cert count, " \
      "expiry, exportability) before setting it; \"cert\" against an empty keychain must " \
      "never be allowed to mint a certificate nobody decided to mint."
    )
  end

  if strategy == "import"
    # Idempotent on purpose: a second release must not fail (or duplicate-import) just because
    # the first release's identity is still sitting in the reused keychain.
    existing = sh("security find-identity -v -p codesigning #{KEYPATH.shellescape} 2>&1", log: false)
    if existing.include?("Apple Distribution")
      UI.message("prepare_signing: an Apple Distribution identity is already present in " \
                 "#{KEYCHAIN} -- skipping import (idempotent reuse)")
    else
      import_certificate(
        certificate_path: ENV.fetch("IMGMGR_DISTRIBUTION_P12_PATH"),
        certificate_password: ENV.fetch("IMGMGR_DISTRIBUTION_P12_PASSWORD"),
        keychain_name: KEYCHAIN, keychain_password: kc_pw,
      )
    end
  else
    # fastlane's `cert` action already reuses a valid existing certificate instead of minting a
    # new one unless `force:` is passed (never passed here) -- so a reused keychain's existing
    # cert from a previous release is picked up rather than re-created.
    cert(api_key: key, keychain_path: KEYPATH, keychain_password: kc_pw,
         output_path: "#{ROOT}/fastlane/certs")
  end

  # A raw .p12 import carries ONLY the leaf cert+key -- no issuer chain. With the search list
  # pinned to this keychain alone, trust-chain validation then fails and codesign reports zero
  # identities even though find-identity-by-path sees the cert (root-caused 2026-08-27: the
  # sibling memosng-ci keychain holds 5 WWDR intermediates installed by fastlane `cert`; a
  # fresh import-strategy keychain holds none). Copy the sibling's PUBLIC certificates -- the
  # demonstrably sufficient chain for this team's certs; no private key travels in a `-p` dump.
  wwdr_present = sh(
    "security find-certificate -a -c 'Apple Worldwide Developer Relations' " \
    "#{KEYPATH.shellescape} 2>/dev/null | grep -c 'keychain' || true", log: false
  ).strip.to_i
  if wwdr_present.zero?
    source_kc = File.expand_path("~/Library/Keychains/memosng-ci.keychain-db")
    UI.user_error!(
      "prepare_signing: #{KEYCHAIN} has no WWDR intermediates and the sibling keychain " \
      "(#{source_kc}) is absent -- import Apple's WWDR CA certificates into #{KEYCHAIN} " \
      "manually (https://www.apple.com/certificateauthority/) before retrying."
    ) unless File.exist?(source_kc)
    chain_pem = "#{ROOT}/build/wwdr-chain.pem"
    FileUtils.mkdir_p(File.dirname(chain_pem))
    File.write(chain_pem, sh("security find-certificate -a -p #{source_kc.shellescape}", log: false))
    sh("security", "import", chain_pem, "-k", KEYPATH, "-T", "/usr/bin/codesign", log: false)
    File.delete(chain_pem)
    UI.message("prepare_signing: issuer chain imported from the sibling keychain (public certs only)")
  end

  # A freshly imported private key is ACL-locked to the importing tool: without an explicit
  # partition-list grant, codesign/xcodebuild see "no identities" although find-identity lists
  # the cert (the reference pipeline never hits this because `cert` grants internally on the
  # keychains it populates). Idempotent; runs for both strategies; log: false keeps the
  # keychain password out of lane output.
  sh("security", "set-key-partition-list", "-S", "apple-tool:,apple:", "-s",
     "-k", kc_pw, KEYPATH, log: false)
  UI.message("prepare_signing: partition-list grant applied (apple-tool:,apple:)")

  prof_app = get_provisioning_profile(
    api_key: key, app_identifier: APP_ID, force: true,
    output_path: "#{ROOT}/fastlane/profiles", filename: "app.mobileprovision",
  )

  # The archive step signs the target directly, so the profile must be written into the project
  # per target -- export_options only governs the (unused) export step.
  update_code_signing_settings(
    use_automatic_signing: false, path: PROJECT, team_id: TEAM_ID,
    targets: [SCHEME], code_sign_identity: "Apple Distribution", profile_name: prof_app,
  )
end

# Signing identity resolution searches keychains IN LIST ORDER, so with more than one keychain
# visible a generic "Apple Distribution" identity string can silently pick up the wrong
# certificate (fold item 7's second half of "pinned to the intended keychain/identity"). Scoped
# to only KEYCHAIN for the duration of signing/archiving, and always restored after.
def pin_keychain_search_list
  previous = sh("security list-keychains -d user", log: false)
                .lines.map { |line| line.strip.gsub(/\A"|"\z/, "") }.reject(&:empty?)
  sh("security list-keychains -d user -s #{KEYPATH.shellescape}")
  begin
    yield
  ensure
    restore = previous.empty? ? [KEYPATH] : previous
    sh("security list-keychains -d user -s " + restore.map(&:shellescape).join(" "))
  end
end

# Fold item 6: the lane refuses to build anything but the exact reviewed commit. A long-lived
# release clone can be stale or dirty and still upload successfully -- verify_attach then proves
# delivery of a build whose SOURCE nobody can name. This makes that impossible: no dirty tree,
# no SHA mismatch, ever.
def assert_provenance!(expected_sha)
  UI.user_error!("archive_ipa needs expected_sha: the commit this build MUST be built from " \
                 "(fold item 6) -- there is no default.") if expected_sha.to_s.strip.empty?

  status = sh("git -C #{ROOT.shellescape} status --porcelain", log: false)
  UI.user_error!("archive_ipa: working tree is dirty -- provenance requires a clean tree:\n#{status}") \
    unless status.strip.empty?

  actual_sha = sh("git -C #{ROOT.shellescape} rev-parse HEAD", log: false).strip
  UI.user_error!(
    "archive_ipa: HEAD is #{actual_sha}, expected_sha was #{expected_sha.strip} -- refusing " \
    "to build a commit nobody asked for."
  ) unless actual_sha == expected_sha.strip

  actual_sha
end

# Diff-gate blocker 3: signing.local.yml is git-ignored, but XcodeGen merges it as an arbitrary
# project.yml fragment -- it is not limited to the three signing keys it exists for. So a stale
# or tampered copy on disk could inject ANY build setting or script phase into a release archive
# while assert_provenance!'s clean-tree/expected-SHA check (which only sees TRACKED content)
# stays green, because this file is invisible to git entirely.
#
# The release lane's own signing is fully determined downstream by prepare_signing's explicit
# update_code_signing_settings call (the TEAM_ID/APP_ID constants plus the fetched profile) --
# it never actually reads this file's content, so the release build needs nothing from it. The
# strongest simple close is therefore to stop trusting the on-disk copy at all for a release:
# overwrite it, unconditionally, with the canonical empty stub immediately before generation, and
# record that stub's sha256 in provenance.json so every release's signing.local.yml input is
# provable after the fact. (Ordinary `bin/generate.sh` usage OUTSIDE this lane -- an Xcode GUI
# device build -- is untouched: it still stubs only when absent, so a developer's real per-machine
# team id survives their own local builds.)
CANONICAL_SIGNING_LOCAL = "{}\n".freeze
SIGNING_LOCAL_SHA_MARKER = "#{ROOT}/build/signing-local.sha256"

def canonicalize_signing_local!
  path = "#{ROOT}/signing.local.yml"
  File.write(path, CANONICAL_SIGNING_LOCAL)
  written = File.binread(path)
  UI.user_error!(
    "archive_ipa: could not canonicalize signing.local.yml before generation -- refusing to " \
    "release rather than trust whatever was already on disk."
  ) unless written == CANONICAL_SIGNING_LOCAL

  sha = Digest::SHA256.hexdigest(written)
  FileUtils.mkdir_p(File.dirname(SIGNING_LOCAL_SHA_MARKER))
  File.write(SIGNING_LOCAL_SHA_MARKER, "#{sha}\n")
  UI.message("signing.local.yml canonicalized to the empty stub for this release (sha256 #{sha})")
  sha
end

# Fold item 4: runbook prose ("generate first") is not enforcement while archive_ipa remains
# directly callable -- so the lane performs generation and the pin check itself, in order,
# every time.
def run_generate_and_assert_pins!
  canonicalize_signing_local!
  sh("#{ROOT.shellescape}/bin/generate.sh")

  root_pins = "#{ROOT}/Package.resolved"
  project_pins = "#{ROOT}/#{PROJECT}/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
  UI.user_error!("archive_ipa: no tracked Package.resolved at #{root_pins} -- the pin file " \
                 "generate.sh is meant to restore does not exist") unless File.exist?(root_pins)
  UI.user_error!("archive_ipa: generate.sh produced no #{project_pins} -- the project never " \
                 "picked up the pinned graph") unless File.exist?(project_pins)

  root_bytes = File.binread(root_pins)
  project_bytes = File.binread(project_pins)
  UI.user_error!(
    "archive_ipa: project Package.resolved is NOT byte-equal to the tracked root file -- " \
    "generate.sh did not restore the pinned graph, so this build would resolve whatever " \
    "versions are current rather than what the repo ships."
  ) unless root_bytes == project_bytes

  UI.message("pins: project Package.resolved is byte-equal to the tracked root file")
end

# The shipped numbers are read off the archive rather than off project.yml: that is what was
# actually built, so the dSYM folder name, the ASC read-back and the archive check cannot drift
# from the upload.
def archive_version(archive)
  plist = "#{archive}/Products/Applications/#{SCHEME}.app/Info.plist"
  UI.user_error!("no Info.plist at #{plist}") unless File.exist?(plist)
  version = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' '#{plist}'", log: false).strip
  build_number = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' '#{plist}'", log: false).strip
  UI.user_error!("could not read version/build from #{plist}") if version.empty? || build_number.empty?
  [version, build_number]
end

# plutil's JSON extraction distinguishes a real Boolean from a String the way Apple's own
# reader does -- a plain PlistBuddy Print cannot (it stringifies everything), which is exactly
# the class of bug fold item 5 exists to catch (a string "NO" satisfying nothing at upload time).
def plist_json_value(plist, key)
  raw = sh("/usr/bin/plutil -extract #{key.shellescape} json -o - #{plist.shellescape} 2>&1",
           log: false)
  JSON.parse(raw)
rescue StandardError
  nil
end

def plist_json_array(plist, key)
  Array(plist_json_value(plist, key))
end

def binary_entitlements_plist(app)
  path = "#{ROOT}/build/binary-entitlements.plist"
  sh("codesign -d --entitlements #{path.shellescape} --xml #{app.shellescape} 2>&1", log: false)
  path
end

# The authoritative App Store Connect build listing -- the second, independent source
# previous_build_number unions against the dSYM stores' provenance records (diff-gate blocker
# 4). Unlike asc_attach_status this is not scoped to one version/build: it lists every build ASC
# holds for the app, because the question here is "what is the highest build number ANY store
# claims was ever uploaded", not "did one specific build attach".
def asc_all_build_numbers
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("previous_build_number: App Store Connect has no app #{APP_ID}") if app.nil?

  builds = Spaceship::ConnectAPI::Build.all(app_id: app.id)
  builds.map do |build|
    n = Integer(build.version.to_s, exception: false)
    UI.user_error!(
      "previous_build_number: App Store Connect returned a build with a non-numeric build " \
      "number (#{build.version.inspect}) -- refusing to treat unreadable ASC history as bootstrap."
    ) if n.nil?
    n
  end
rescue StandardError => e
  UI.user_error!(
    "previous_build_number: could not read App Store Connect's build history (#{e.class}: " \
    "#{e.message}) -- refusing to treat an unreachable authoritative source as bootstrap."
  )
end

# Which build the highest previous release ANYWHERE claims -- the authority the version/build
# check advances past. project.yml's numbers are NOT this authority: they are the intent, not
# what was actually uploaded.
#
# Diff-gate blocker 4: the earlier version asked only the FIRST reachable dSYM store (primary,
# or fallback if primary was down) and silently discarded any record it could not parse. Both
# were data-loss bugs wearing a bootstrap hat: a build preserved to lexosaurus while janus was
# briefly down became invisible the moment janus came back (nobody unions the two), and a
# corrupt or hand-edited provenance.json quietly became "no history at all" -- either one could
# let 0.1.0 (1) pass a second time. This version UNIONS every reachable store's records with
# ASC's own authoritative listing and takes the max; a store that is merely unreachable is
# skipped (matching DsymStore's own reachability semantics elsewhere), but a record that IS
# present and unreadable, or an unreachable ASC, fails the lane outright rather than resolving
# to nil. nil is returned ONLY when every reachable source was consulted and genuinely held no
# history at all -- the real first-proof bootstrap case.
def previous_build_number
  reachable_stores = DSYM_STORES.select { |_name, root| dsym_store_reachable?(root) }
  UI.user_error!(
    "previous_build_number: no dSYM store is reachable (tried #{DSYM_STORES.map(&:first).join(', ')}) " \
    "-- cannot establish release history; refusing to guess bootstrap."
  ) if reachable_stores.empty?

  store_builds = reachable_stores.flat_map do |name, root|
    Dir.glob(File.join(root, DSYM_SUBPATH, "*", "provenance.json")).map do |path|
      parsed = JSON.parse(File.read(path))
      n = Integer(parsed["build"].to_s, exception: false)
      UI.user_error!(
        "previous_build_number: #{path} (store #{name}) has an unreadable or non-numeric " \
        "\"build\" field (#{parsed["build"].inspect}) -- refusing to treat corrupt release " \
        "history as bootstrap. Fix or deliberately remove the record before releasing again."
      ) if n.nil?
      n
    rescue JSON::ParserError => e
      UI.user_error!(
        "previous_build_number: #{path} (store #{name}) is not valid JSON (#{e.message}) -- " \
        "refusing to treat corrupt release history as bootstrap."
      )
    end
  end

  asc_builds = asc_all_build_numbers
  all_builds = store_builds + asc_builds
  all_builds.empty? ? nil : all_builds.max
end

# Fold item 5: read the BUILT archive, never project.yml -- a green generate only proves the
# spec was well-formed. Every fact here comes off the .xcarchive Xcode actually produced.
def archive_facts(archive, previous_build)
  app = "#{archive}/Products/Applications/#{SCHEME}.app"
  info_plist = "#{app}/Info.plist"
  UI.user_error!("archive_facts: no Info.plist at #{info_plist}") unless File.exist?(info_plist)

  bundle_id = sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' #{info_plist.shellescape}",
                 log: false).strip
  version, build_number = archive_version(archive)
  icon_name = begin
    sh("/usr/libexec/PlistBuddy -c 'Print :CFBundleIconName' #{info_plist.shellescape}", log: false).strip
  rescue StandardError
    nil
  end

  codesign_out = sh("codesign -dv --verbose=4 #{app.shellescape} 2>&1", log: false)
  signing_authority = codesign_out[/^Authority=(.+)$/, 1]
  codesign_verify_ok = system("codesign --verify --deep --strict #{app.shellescape} >/dev/null 2>&1")

  profile_path = "#{app}/embedded.mobileprovision"
  UI.user_error!("archive_facts: no embedded.mobileprovision at #{profile_path}") unless File.exist?(profile_path)
  profile_plist = "#{ROOT}/build/embedded-profile.plist"
  sh("security cms -D -i #{profile_path.shellescape} > #{profile_plist.shellescape}", log: false)
  profile_app_id = sh(
    "/usr/libexec/PlistBuddy -c 'Print :Entitlements:application-identifier' #{profile_plist.shellescape}",
    log: false,
  ).strip
  profile_team_ids = plist_json_array(profile_plist, "TeamIdentifier")

  entitlements_plist = binary_entitlements_plist(app)
  get_task_allow = plist_json_value(entitlements_plist, "get-task-allow")

  binary_uuids = sh("dwarfdump --uuid #{(app + '/' + SCHEME).shellescape} 2>&1", log: false)
                 .scan(/UUID: ([0-9A-Fa-f-]+)/).flatten
  dsym_uuids = Dir.glob("#{archive}/dSYMs/*.dSYM").flat_map do |bundle|
    sh("dwarfdump --uuid #{bundle.shellescape} 2>&1", log: false).scan(/UUID: ([0-9A-Fa-f-]+)/).flatten
  end

  {
    bundle_id: bundle_id, expected_bundle_id: APP_ID,
    version: version, build_number: build_number, previous_build: previous_build,
    encryption_flag: plist_json_value(info_plist, "ITSAppUsesNonExemptEncryption"),
    orientations: plist_json_array(info_plist, "UISupportedInterfaceOrientations"),
    icon_name: icon_name, assets_car_present: File.exist?("#{app}/Assets.car"),
    signing_authority: signing_authority, codesign_verify_ok: codesign_verify_ok,
    profile_app_id: profile_app_id, profile_team_ids: profile_team_ids, expected_team_id: TEAM_ID,
    get_task_allow: get_task_allow,
    binary_uuids: binary_uuids, dsym_uuids: dsym_uuids,
  }
end

def run_archive_checks!(archive, previous_build)
  facts = archive_facts(archive, previous_build)
  results = ArchiveCheck.verdict(**facts)
  results.each do |result|
    result.ok? ? UI.message("archive check ok: #{result.name} -- #{result.message}") \
               : UI.error("archive check FAILED: #{result.name} -- #{result.message}")
  end
  failed = ArchiveCheck.failures(results)
  UI.user_error!(
    "archive_ipa: #{failed.size} of #{results.size} archive check(s) failed:\n" +
    failed.map { |r| "  - #{r.name}: #{r.message}" }.join("\n")
  ) unless failed.empty?
  UI.success("archive checks: all #{results.size} passed")
end

def write_provenance!(dest:, sha:, version:, build_number:)
  # Diff-gate blocker 3: the exact signing.local.yml content this build was generated against
  # (the canonical empty stub -- see canonicalize_signing_local!) is provable after the fact,
  # not merely asserted at build time.
  signing_local_sha = File.exist?(SIGNING_LOCAL_SHA_MARKER) ? File.read(SIGNING_LOCAL_SHA_MARKER).strip : nil
  record = {
    "sha" => sha, "version" => version, "build" => build_number,
    "signing_local_sha256" => signing_local_sha,
    "written_at" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ"),
  }
  path = File.join(dest, "provenance.json")
  File.write(path, "#{JSON.pretty_generate(record)}\n")
  UI.message("provenance: wrote #{path} (#{record})")
  path
end

# Listing is what triggers janus's autofs mount, so probe by listing rather than by File.exist?.
# The listing runs OUT OF PROCESS (see TimedProbe): both of these calls are the ones that block
# forever on a hung NFS hard mount, and a release lane that stalls on a dead NAS never reaches the
# fallback that exists precisely for that case.
def dsym_store_reachable?(root)
  quoted = Shellwords.escape(root)
  TimedProbe.ok?("/bin/ls #{quoted} && /bin/test -w #{quoted}", seconds: DSYM_PROBE_TIMEOUT)
end

# The Spaceship half of the read-back: fetch, hand the facts to the pure verdict, return it.
def asc_attach_status(version:, build_number:)
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  return [:fail, "App Store Connect has no app #{APP_ID}"] if app.nil?

  group = app.get_beta_groups.find { |candidate| candidate.name == GROUP }
  return [:fail, "App Store Connect has no beta group #{GROUP.inspect}"] if group.nil?

  build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build_number).first
  AscReadback.verdict(
    build: build,
    group_build_ids: group.fetch_builds.map(&:id),
    beta_detail: build && build.build_beta_detail,
    group_name: GROUP,
  )
end

platform :ios do
  # Xcode 26.6's `-exportArchive` CreateIPA step fails with an opaque "Copy failed" on the
  # reference project (app itself copies fine with ditto) -- ported defensively; if this build
  # does not hit that failure the hand-zipped Payload/ route is still a valid App Store IPA and
  # costs nothing extra to keep.
  desc "Generate, verify pins, sign, archive and check -- no upload (fold items 2/4/5/6)"
  lane :archive_ipa do |options|
    expected_sha = options[:expected_sha]
    actual_sha = assert_provenance!(expected_sha)

    run_generate_and_assert_pins!

    key = api_key
    previous_build = previous_build_number

    with_release_lock do
      pin_keychain_search_list do
        prepare_signing(key)

        sh("rm -rf #{ARCHIVE.shellescape} #{IPA.shellescape} #{(ROOT + '/build/Payload').shellescape}")
        build_app(
          project: PROJECT, scheme: SCHEME, configuration: "Release",
          skip_package_ipa: true, clean: true,
          archive_path: ARCHIVE, derived_data_path: "#{ROOT}/build/dd",
          # Fold item 4: the archive itself is proven to have resolved from the SAME graph the
          # pin check just verified, not merely built after that check happened to pass.
          xcargs: "-onlyUsePackageVersionsFromResolvedFile",
        )

        run_archive_checks!(ARCHIVE, previous_build)
      end
    end

    app = "#{ARCHIVE}/Products/Applications/#{SCHEME}.app"
    sh("mkdir -p #{(ROOT + '/build/Payload').shellescape} && " \
       "ditto #{app.shellescape} #{(ROOT + '/build/Payload/' + SCHEME + '.app').shellescape} && " \
       "cd #{(ROOT + '/build').shellescape} && /usr/bin/zip -qry #{File.basename(IPA)} Payload")
    UI.success("IPA ready: #{IPA} (built from #{actual_sha})")
    IPA
  end

  # Builds shipped with no preserved symbols cannot ever be symbolicated. This lane fails loudly
  # rather than skipping -- a silent skip is exactly the defect this exists to close. Fold item
  # 6: it also writes the provenance record BESIDE the dSYMs it just copied.
  desc "Copy an archive's dSYMs into the off-host store, print their UUIDs, write provenance"
  lane :preserve_dsyms do |options|
    archive = (options[:archive] || ARCHIVE).to_s
    UI.user_error!("preserve_dsyms: no archive at #{archive}") unless Dir.exist?(archive)

    bundles = Dir.glob(File.join(archive, "dSYMs", "*.dSYM")).sort
    UI.user_error!("preserve_dsyms: #{archive}/dSYMs holds no .dSYM bundle") if bundles.empty?

    supplied_version = options[:version].to_s
    supplied_build = options[:build].to_s
    archive_v = ""
    archive_b = ""
    archive_v, archive_b = archive_version(archive) if supplied_version.empty? || supplied_build.empty?
    version, build_number = DsymStore.release_label(
      version: supplied_version, build: supplied_build,
      archive_version: archive_v, archive_build: archive_b,
    )
    UI.user_error!("preserve_dsyms: could not resolve a version/build to file under") if version.empty? || build_number.empty?

    status, root, message = DsymStore.choose(DSYM_STORES) { |candidate| dsym_store_reachable?(candidate) }
    UI.user_error!("preserve_dsyms: #{message}") if status == :none
    status == :fallback ? UI.important(message) : UI.message(message)

    dest = File.join(root, DSYM_SUBPATH, "#{version}-#{build_number}")
    sh("mkdir -p #{dest.shellescape}")
    bundles.each { |bundle| sh("ditto #{bundle.shellescape} #{(dest + '/' + File.basename(bundle)).shellescape}") }

    copied = Dir.glob(File.join(dest, "*.dSYM")).sort
    UI.user_error!("preserve_dsyms: nothing landed in #{dest}") if copied.empty?

    copied.each do |bundle|
      sh("dwarfdump --uuid #{bundle.shellescape}", log: false).each_line do |line|
        UI.important(line.rstrip) unless line.strip.empty?
      end
    end

    sha = options[:sha].to_s
    if sha.empty?
      UI.important("preserve_dsyms: no sha: given -- provenance record NOT written (fold item 6 " \
                   "expects the beta/archive_ipa lane to supply it)")
    else
      write_provenance!(dest: dest, sha: sha, version: version, build_number: build_number)
    end

    UI.success("dSYMs preserved for #{version} (#{build_number}): #{copied.size} bundle(s) in #{dest}")
    dest
  end

  # `upload_to_testflight` exits 0 on its own success, which is not the same thing as the
  # household being able to see the build -- so the release reads App Store Connect back and
  # fails when the attach did not land.
  desc "Read App Store Connect back: the build is VALID, attached to household, and in testing"
  lane :verify_attach do |options|
    version = options[:version].to_s
    build_number = options[:build].to_s
    UI.user_error!("verify_attach needs version:<marketing> build:<number>") if version.empty? || build_number.empty?

    api_key # also installs the Spaceship token this read-back queries with
    deadline = Time.now + ATTACH_TIMEOUT
    message = "no read-back was attempted"

    loop do
      unless AscReadback.may_request?(now: Time.now, deadline: deadline)
        UI.user_error!("ASC read-back TIMED OUT after #{ATTACH_TIMEOUT}s for " \
                       "#{version} (#{build_number}): #{message}")
      end

      status, message = asc_attach_status(version: version, build_number: build_number)
      UI.user_error!("ASC read-back FAILED for #{version} (#{build_number}): #{message}") if status == :fail

      if status == :ok
        UI.success("ASC read-back OK for #{version} (#{build_number}): #{message}")
        break
      end

      wait = AscReadback.next_wait(now: Time.now, deadline: deadline, interval: ATTACH_INTERVAL)
      if wait.nil?
        UI.user_error!("ASC read-back TIMED OUT after #{ATTACH_TIMEOUT}s for " \
                       "#{version} (#{build_number}): #{message}")
      end
      UI.message("ASC read-back not settled yet: #{message} - retrying in #{wait}s")
      sleep(wait)
    end
  end

  desc "Build and upload to TestFlight (headless). Needs expected_sha: (fold item 6)"
  lane :beta do |options|
    expected_sha = options[:expected_sha]
    archive_ipa(expected_sha: expected_sha)
    version, build_number = archive_version(ARCHIVE)
    preserve_dsyms(archive: ARCHIVE, version: version, build: build_number, sha: expected_sha)
    # No skip_waiting here: leaving before ASC finishes processing means the group assignment
    # silently never runs, and with an internal group that cannot be hasAccessToAllBuilds (the
    # API refuses to enable it post-creation), an unattached build is INVISIBLE to every tester.
    # Waiting costs minutes and makes distribution real. NEVER pass
    # skip_waiting_for_build_processing here -- see docs/TESTFLIGHT.md.
    #
    # submit_beta_review defaults to TRUE and posts a Beta App Review submission -- an
    # EXTERNAL-testing requirement the internal household group neither needs nor satisfies.
    # Both flags below are explicit for that reason, not merely to match the defaults.
    upload_to_testflight(
      api_key: api_key, ipa: IPA, groups: [GROUP],
      distribute_external: false, submit_beta_review: false,
    )
    verify_attach(version: version, build: build_number)
  end
end
